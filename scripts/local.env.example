# This Mac's own values for the release and device scripts. Copy to
# scripts/local.env, which git ignores, and fill in. Read by push-appstore.sh
# and deploy-device.sh.

# App Store Connect API key (push-appstore.sh). The key file itself stays out of
# the repository, as AuthKey_<key id>.p8 in ~/.private_keys or
# ~/.appstoreconnect/private_keys, where altool looks for it.
BK_ASC_KEY_ID=
BK_ASC_ISSUER=

# deploy-device.sh: the device (`xcrun devicectl list devices`), the signing
# identity (`security find-identity -v -p codesigning`) and the UUID of the
# development provisioning profile in
# ~/Library/Developer/Xcode/UserData/Provisioning Profiles.
BK_DEVICE=
BK_SIGN_IDENTITY=
BK_PROFILE_UUID=
